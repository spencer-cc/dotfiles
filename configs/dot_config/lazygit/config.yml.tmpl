# Generated by chezmoi from .chezmoidata/colors.toml
# Do not edit — changes will be overwritten
# See docs/colorscheme.md for reference

notARepository: quit
disableStartupPopups: true
promptToReturnFromSubprocess: false

git:
  autoFetch: false
  disableForcePushing: true
  diffRenderers:
    - command: "delta --paging=never"

os:
  editPreset: nvim
  editAtLine: "nvim {{ "{{" }}filename{{ "}}" }} +{{ "{{" }}line{{ "}}" }}"
  openDirInEditor: "nvim {{ "{{" }}filename{{ "}}" }}"

gui:
  expandFocusedSidePanel: true
  tabWidth: 2
  enlargedSideViewLocation: left
  sidePanelWidth: 0.25
  expandedSidePanelWeight: 3
  showRootItemInFileTree: false
  fileTreeSortOrder: foldersFirst
  showBottomLine: false
  showCommandLog: false
  nerdFontsVersion: "3"
  showDivergenceFromBaseBranch: arrowAndNumber
  border: rounded
  statusPanelView: allBranchesLog

  spinner:
    rate: 100
    frames:
      - "⠋"
      - "⠙"
      - "⠹"
      - "⠸"
      - "⠼"
      - "⠴"
      - "⠦"
      - "⠧"
      - "⠇"
      - "⠏"

  theme:
    activeBorderColor:
      - "#{{ .colors.syntax.number }}"
      - bold
    inactiveBorderColor:
      - "#{{ .colors.ui.fg_muted }}"
    optionsTextColor:
      - "#{{ .colors.syntax.function }}"
    selectedLineBgColor:
      - "#{{ .colors.ui.surface_sunken }}"
    cherryPickedCommitBgColor:
      - "#{{ .colors.ui.surface }}"
    cherryPickedCommitFgColor:
      - "#{{ .colors.syntax.number }}"
    unstagedChangesColor:
      - "#{{ .colors.diagnostic.error }}"
    defaultFgColor:
      - "#{{ .colors.ui.fg }}"
    searchingActiveBorderColor:
      - "#{{ .colors.syntax.type }}"
    inactiveViewSelectedLineBgColor:
      - "#{{ .colors.ui.surface_raised }}"
    markedBaseCommitFgColor:
      - "#{{ .colors.syntax.keyword }}"
    markedBaseCommitBgColor:
      - "#{{ .colors.ui.surface }}"

    branchColorPatterns:
      "^(main|master)$": "#{{ .colors.syntax.function }}"
      "^develop$": "#{{ .colors.syntax.property }}"
      "^(feat|feature)/": "#{{ .colors.syntax.string }}"
      "^fix/": "#{{ .colors.syntax.number }}"
      "^(chore|docs|refactor|test|ci)/": "#{{ .colors.syntax.keyword }}"

    authorColors:
      "*": "#{{ .colors.palette.lilac }}"
