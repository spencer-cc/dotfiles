{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "blue",
      "green",
      "yellow",
      "orange",
      "red",
      "cyan"
    ],
    "text": {
      "base": "#cdd6f4",
      "muted": "#bac2de",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.accent.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#ee668c",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "#ee668c"
        },
        "warning": {
          "base": "#f0d57c"
        },
        "success": {
          "base": "#8ae28e"
        },
        "info": {
          "base": "#6addca"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#181825",
        "high": "#11111b",
        "max": "#11111b"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.accent.400",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#ee668c"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#313244"
    },
    "scrollbar": {
      "base": "#45475a"
    },
    "diff": {
      "text": {
        "added": "#8ae28e",
        "removed": "#ee668c",
        "context": "#9399b2",
        "hunkHeader": "#f59a64"
      },
      "background": {
        "added": "#a6e3a180",
        "removed": "#f38ba880",
        "context": "#181825"
      },
      "highlight": {
        "added": "#8ae28e",
        "removed": "#ee668c"
      },
      "lineNumber": {
        "text": "#45475a",
        "background": {
          "added": "#a6e3a140",
          "removed": "#f38ba840"
        }
      }
    },
    "syntax": {
      "comment": "#9399b2",
      "keyword": "#c490f0",
      "function": "#7aacf9",
      "variable": "#ee668c",
      "string": "#8ae28e",
      "number": "#f59a64",
      "type": "#f0d57c",
      "operator": "#6cd2ea",
      "punctuation": "#cdd6f4"
    },
    "markdown": {
      "text": "#cdd6f4",
      "heading": "#c490f0",
      "link": "#7aacf9",
      "linkText": "#6cd2ea",
      "code": "#8ae28e",
      "blockQuote": "#f0d57c",
      "emphasis": "#f0d57c",
      "strong": "#f59a64",
      "horizontalRule": "#a6adc8",
      "listItem": "#7aacf9",
      "listEnumeration": "#6cd2ea",
      "image": "#7aacf9",
      "imageText": "#6cd2ea",
      "codeBlock": "#cdd6f4"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#cdd6f4",
        "200": "#bac2de",
        "300": "#a6adc8",
        "400": "#9399b2",
        "500": "#7f849c",
        "600": "#6c7086",
        "700": "#585b70",
        "800": "#45475a",
        "900": "#313244"
      },
      "red": {
        "100": "#f2b5c8",
        "200": "#f094af",
        "300": "#ef7a9b",
        "400": "#ee668c",
        "500": "#d85e81",
        "600": "#b04e6c",
        "700": "#8b4059",
        "800": "#693348",
        "900": "#482637"
      },
      "orange": {
        "100": "#f5ccb6",
        "200": "#f5b794",
        "300": "#f5a779",
        "400": "#f59a64",
        "500": "#de8c5d",
        "600": "#b57450",
        "700": "#8e5c43",
        "800": "#6c4838",
        "900": "#4a332d"
      },
      "yellow": {
        "100": "#f3e7c1",
        "200": "#f2dfa4",
        "300": "#f1d98e",
        "400": "#f0d57c",
        "500": "#dac172",
        "600": "#b29e61",
        "700": "#8c7d50",
        "800": "#6a5f42",
        "900": "#494233"
      },
      "green": {
        "100": "#c5ecc9",
        "200": "#ace8b1",
        "300": "#99e59d",
        "400": "#8ae28e",
        "500": "#7ecd82",
        "600": "#68a76e",
        "700": "#54845a",
        "800": "#416549",
        "900": "#2f4538"
      },
      "cyan": {
        "100": "#b6eae4",
        "200": "#96e5d9",
        "300": "#7de0d1",
        "400": "#6addca",
        "500": "#61c9b8",
        "600": "#51a499",
        "700": "#42817b",
        "800": "#356361",
        "900": "#274447"
      },
      "blue": {
        "100": "#bed4fa",
        "200": "#a1c3f9",
        "300": "#8bb6f9",
        "400": "#7aacf9",
        "500": "#709ce3",
        "600": "#5d81bb",
        "700": "#4b6695",
        "800": "#3b4f74",
        "900": "#2b3852"
      },
      "purple": {
        "100": "#dfc8f6",
        "200": "#d4b0f3",
        "300": "#cb9ef1",
        "400": "#c490f0",
        "500": "#b283db",
        "600": "#926cb4",
        "700": "#735790",
        "800": "#594470",
        "900": "#3e3150"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
