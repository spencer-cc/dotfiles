{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-mocha-mauve",
    "mode": "dark"
  },
  "keybinds": {
    "input.submit": "shift+return,ctrl+return,alt+return,ctrl+j",
    "input.newline": "return",
    "agent.cycle": "tab"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "volume": 1,
    "notifications": true
  },
  "prompt": {
    "image_preview": true
  },
  "tabs": {
    "mode": "on",
    "layout": "horizontal",
    "indicators": "status"
  }
}
