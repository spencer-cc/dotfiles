{
  "$schema": "https://opencode.ai/config.json",
  "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
  "default_agent": "plan",
  "share": "disabled",
  "experimental": {
    "subagent_depth": 2,
  },
  "plugins": [],
  "providers": {
    "synthetic": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "synthetic",
      "settings": {
        "baseURL": "https://api.synthetic.new/openai/v1",
      },
      "models": {
        "hf:zai-org/GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 524288,
            "output": 65536,
          },
          "cost": {
            "input": 0.15,
            "output": 0.5,
            "cache": {
              "read": 0.04,
              "write": 0,
            },
          },
          "settings": {
            "reasoningEffort": "medium",
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
          ],
        },
        "hf:zai-org/GLM-5.3": {
          "name": "GLM 5.3",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
          "limit": {
            "context": 524288,
            "output": 65536,
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache": {
              "read": 0.26,
              "write": 0,
            },
          },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } },
          ],
        },
      },
    },
  },
  // Permission rules are ordered; the last matching rule wins.
  "permissions": [
    // --- global defaults (converted from V1 permission map, same order/semantics) ---
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "nu *", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "brew list", "effect": "allow" },
    { "action": "shell", "resource": "* --version", "effect": "allow" },
    { "action": "shell", "resource": "* --help", "effect": "allow" },
    { "action": "shell", "resource": "just *", "effect": "allow" },
    { "action": "shell", "resource": "pdftotext *", "effect": "allow" },
    { "action": "shell", "resource": "pdftoppm *", "effect": "allow" },
    { "action": "shell", "resource": "pdfinfo *", "effect": "allow" },
    { "action": "shell", "resource": "tesseract *", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "deny" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "pass-cli *", "effect": "deny" },
  ],
  "agents": {
    "plan": {
      "mode": "primary",
      "color": "#f59a64",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash#medium",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.priv", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "lsp", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "codesearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "doom_loop", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        {
          "action": "external_directory",
          "resource": "/tmp",
          "effect": "allow",
        },
        {
          "action": "external_directory",
          "resource": "~/.local/share/nvim",
          "effect": "allow",
        },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "subagent", "resource": "librarian", "effect": "allow" },
        { "action": "subagent", "resource": "oracle", "effect": "ask" },
      ],
    },
    "build": {
      "mode": "primary",
      "color": "#67c0ea",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash#medium",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.priv", "effect": "deny" },
        // V2 folds write + patch into the edit action
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "lsp", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "codesearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "doom_loop", "resource": "*", "effect": "ask" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        {
          "action": "external_directory",
          "resource": "/tmp",
          "effect": "allow",
        },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "oracle", "effect": "ask" },
      ],
    },
    "explorer": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash#low",
      "steps": 12,
      "hidden": false,
      "permissions": [
        // --- read-only shell allowlist (shared across explorer/librarian/documenter/oracle) ---
        { "action": "shell", "resource": "*", "effect": "deny" },
        // text inspection
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "nl *", "effect": "allow" },
        { "action": "shell", "resource": "cut *", "effect": "allow" },
        { "action": "shell", "resource": "sort *", "effect": "allow" },
        { "action": "shell", "resource": "uniq *", "effect": "allow" },
        { "action": "shell", "resource": "tr *", "effect": "allow" },
        { "action": "shell", "resource": "fold *", "effect": "allow" },
        { "action": "shell", "resource": "column *", "effect": "allow" },
        { "action": "shell", "resource": "strings *", "effect": "allow" },
        { "action": "shell", "resource": "tac *", "effect": "allow" },
        { "action": "shell", "resource": "rev *", "effect": "allow" },
        { "action": "shell", "resource": "seq *", "effect": "allow" },
        { "action": "shell", "resource": "jq *", "effect": "allow" },
        { "action": "shell", "resource": "xxd *", "effect": "allow" },
        { "action": "shell", "resource": "od *", "effect": "allow" },
        // search and diff
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "tree *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "ls", "effect": "allow" },
        { "action": "shell", "resource": "tree", "effect": "allow" },
        { "action": "shell", "resource": "mdfind *", "effect": "allow" },
        { "action": "shell", "resource": "diff *", "effect": "allow" },
        { "action": "shell", "resource": "cmp *", "effect": "allow" },
        { "action": "shell", "resource": "comm *", "effect": "allow" },
        // find guards: deny mutation/output-file primaries after the broad allow
        { "action": "shell", "resource": "find *-delete*", "effect": "deny" },
        { "action": "shell", "resource": "find *-exec*", "effect": "deny" },
        { "action": "shell", "resource": "find *-ok*", "effect": "deny" },
        { "action": "shell", "resource": "find *-fls *", "effect": "deny" },
        { "action": "shell", "resource": "find *-fprint*", "effect": "deny" },
        // file metadata
        { "action": "shell", "resource": "file *", "effect": "allow" },
        { "action": "shell", "resource": "stat *", "effect": "allow" },
        { "action": "shell", "resource": "du *", "effect": "allow" },
        { "action": "shell", "resource": "du", "effect": "allow" },
        { "action": "shell", "resource": "df *", "effect": "allow" },
        { "action": "shell", "resource": "df", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "pwd *", "effect": "allow" },
        { "action": "shell", "resource": "realpath *", "effect": "allow" },
        { "action": "shell", "resource": "readlink *", "effect": "allow" },
        { "action": "shell", "resource": "basename *", "effect": "allow" },
        { "action": "shell", "resource": "dirname *", "effect": "allow" },
        { "action": "shell", "resource": "which *", "effect": "allow" },
        { "action": "shell", "resource": "type *", "effect": "allow" },
        { "action": "shell", "resource": "date", "effect": "allow" },
        { "action": "shell", "resource": "date *", "effect": "allow" },
        { "action": "shell", "resource": "id", "effect": "allow" },
        { "action": "shell", "resource": "whoami", "effect": "allow" },
        { "action": "shell", "resource": "hostname", "effect": "allow" },
        { "action": "shell", "resource": "uname *", "effect": "allow" },
        { "action": "shell", "resource": "uname", "effect": "allow" },
        { "action": "shell", "resource": "sw_vers", "effect": "allow" },
        { "action": "shell", "resource": "ps *", "effect": "allow" },
        { "action": "shell", "resource": "ps", "effect": "allow" },
        // hashes
        { "action": "shell", "resource": "md5 *", "effect": "allow" },
        { "action": "shell", "resource": "shasum *", "effect": "allow" },
        { "action": "shell", "resource": "md5sum *", "effect": "allow" },
        { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
        { "action": "shell", "resource": "cksum *", "effect": "allow" },
        // macOS read-only
        { "action": "shell", "resource": "plutil -p *", "effect": "allow" },
        { "action": "shell", "resource": "defaults read *", "effect": "allow" },
        { "action": "shell", "resource": "defaults read", "effect": "allow" },
        // text processing: sed print-only (deny first, -n allow after)
        { "action": "shell", "resource": "sed *", "effect": "deny" },
        { "action": "shell", "resource": "sed -n *", "effect": "allow" },
        // awk can call system() and redirect via print > "file" - accepted risk
        { "action": "shell", "resource": "awk *", "effect": "allow" },
        // sort output-file guards
        { "action": "shell", "resource": "sort -o *", "effect": "deny" },
        { "action": "shell", "resource": "sort * -o *", "effect": "deny" },
        { "action": "shell", "resource": "sort *--output*", "effect": "deny" },
        // piped-execution guards
        { "action": "shell", "resource": "xargs", "effect": "deny" },
        { "action": "shell", "resource": "xargs *", "effect": "deny" },
        { "action": "shell", "resource": "tee *", "effect": "deny" },
        // git read-only
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git branch", "effect": "allow" },
        { "action": "shell", "resource": "git blame *", "effect": "allow" },
        // --- tools ---
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.priv", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
      ],
    },
    "librarian": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash#medium",
      "steps": 10,
      "hidden": false,
      "permissions": [
        // --- read-only shell allowlist (shared across explorer/librarian/documenter/oracle) ---
        { "action": "shell", "resource": "*", "effect": "deny" },
