{
  "$schema": "https://opencode.ai/config.json",
  "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
  "small_model": "synthetic/hf:zai-org/GLM-4.7-Flash",
  "default_agent": "plan",
  "share": "disabled",
  "subagent_depth": 2,
  "plugins": [
    "@mohak34/opencode-notifier@latest",
  ],
  "provider": {
    "synthetic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "synthetic",
      "options": {
        "baseURL": "https://api.synthetic.new/openai/v1",
      },
      "models": {
        "hf:zai-org/GLM-5.3-Flash": {
          "name": "GLM 5.3 Flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "limit": {
            "context": 524288,
            "output": 65536,
          },
          "cost": {
            "input": 0.15,
            "output": 0.5,
          },
          "family": "GLM",
          "reasoning": true,
        },
        "hf:zai-org/GLM-4.7-Flash": {
          "name": "GLM 4.7 Flash",
          "limit": {
            "context": 196608,
            "output": 65536,
          },
          "cost": {
            "input": 0.1,
            "output": 0.5,
          },
          "family": "GLM",
          "reasoning": true,
        },
      },
    },
  },
  "permission": {
    "*": "deny",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "nu *": "allow",
      "make *": "allow",
      "pwd *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "which *": "allow",
      "brew list": "allow",
      "* --version": "allow",
      "* --help": "allow",
      "just *": "allow",
      "pdftotext *": "allow",
      "pdftoppm *": "allow",
      "pdfinfo *": "allow",
      "tesseract *": "allow",
      "git *": "deny",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "rm -rf *": "deny",
      "pass-cli *": "deny",
    },
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "color": "#f59a64",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "reasoningEffort": "medium",
      "permission": {
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "codesearch": "allow",
        "question": "allow",
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
          "~/.local/share/nvim": "allow",
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "librarian": "allow",
          "oracle": "ask",
        },
      },
    },
    "build": {
      "mode": "primary",
      "color": "#67c0ea",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "reasoningEffort": "medium",
      "permission": {
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "edit": "allow",
        "write": "allow",
        "patch": "ask",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "codesearch": "allow",
        "question": "allow",
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
        },
        "task": {
          "*": "allow",
          "oracle": "ask",
        },
      },
    },
    "explorer": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-4.7-Flash",
      "steps": 12,
      "temperature": 0.2,
      "reasoningEffort": "low",
      "hidden": false,
      "permission": {
        "bash": "deny",
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
      },
    },
    "librarian": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-4.7-Flash",
      "steps": 10,
      "temperature": 0.2,
      "reasoningEffort": "medium",
      "hidden": false,
      "permission": {
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow",
      },
    },
    "documenter": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-4.7-Flash",
      "steps": 10,
      "temperature": 0.2,
      "reasoningEffort": "medium",
      "hidden": true,
      "permission": {
        "bash": "deny",
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "edit": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
      },
    },
    "fixer": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "steps": 25,
      "temperature": 0.2,
      "reasoningEffort": "low",
      "hidden": true,
      "permission": {
        "bash": {
          "*": "deny",
          "just *": "allow",
          "make *": "allow",
          "npm run *": "allow",
          "bun test *": "allow",
          "bun run *": "allow",
          "pytest *": "allow",
          "cargo test *": "allow",
          "cargo check *": "allow",
          "go test *": "allow",
          "go vet *": "allow",
          "git diff *": "allow",
          "git status": "allow",
        },
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "edit": "allow",
        "write": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
      },
    },
    "compaction": {
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "reasoningEffort": "low",
      "hidden": true,
      "permission": {
        "*": "deny",
      },
    },
    "oracle": {
      "mode": "subagent",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "steps": 12,
      "temperature": 0.2,
      "reasoningEffort": "max",
      "hidden": false,
      "permission": {
        "bash": "deny",
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "task": {
          "*": "deny",
          "explorer": "allow",
          "librarian": "allow",
        },
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
        },
      },
    },
    "help": {
      "mode": "primary",
      "color": "#ee9dd4",
      "model": "synthetic/hf:zai-org/GLM-5.3-Flash",
      "reasoningEffort": "medium",
      "temperature": 0.3,
      "permission": {
        "read": {
          "*": "allow",
          "*.priv": "deny",
        },
        "bash": {
          "*": "deny",
          "nu *": "deny",
          "make *": "deny",
          "just *": "deny",
          "find *": "deny",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git rev-parse *": "allow",
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow",
        "codesearch": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "doom_loop": "ask",
        "external_directory": {
          "*": "ask",
          "/tmp": "allow",
          "~/.local/share/nvim": "allow",
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "librarian": "allow",
        },
        "question": "deny",
      },
    },
  },
}
