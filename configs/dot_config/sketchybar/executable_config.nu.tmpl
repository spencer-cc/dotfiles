#!/usr/bin/env nu -n

# Transparency codes
# 100%:  0xFF
# 75%: 0xBF
# 50%: 0x80
# 25%: 0x40

const theme = {
  name: "colorscheme-normal"
  colors: {
    transparent: "0x00ffffff"
    light_gray: "0xFF{{ .colors.ui.fg_muted }}"
    white: "0xFF{{ .colors.ui.fg }}"
    red: "0xFF{{ .colors.diagnostic.error }}"
    yellow: "0xFF{{ .colors.syntax.type }}"
    blue: "0xFF{{ .colors.syntax.function }}"
    green: "0xFF{{ .colors.syntax.string }}"
    magenta: "0xFF{{ .colors.palette.pink }}"
    cyan: "0xFF{{ .colors.palette.cyan }}"
    orange: "0xFF{{ .colors.syntax.number }}"
    tangerine: "0xFF{{ .colors.palette.red_soft }}"
    purple: "0xFF{{ .colors.syntax.keyword }}"
    black: "0xFF{{ .colors.ui.bg }}"
    black_75: "0xBF{{ .colors.ui.bg }}"
  }
}

# TODO: define standard sizes?
const fonts = {
  icon: {family: "SpaceMono Nerd Font Mono", style: Bold, size: 20}
  label: {family: "JetBrainsMono Nerd Font Mono", style: Bold, size: 17}
  ske_app: {family: sketchybar-app-font, style: Regular, size: 14}
}

const defaults = {
  bar: {
    height: 56
    y_offset: -10
    position: top
    color: transparent
  }
  bracket: {
    height: 28
    color: $"($theme.colors.black_75)"
    corner_radius: 4
    border_width: 1
  }
  label: {
    font: $fonts.label
    padding: {left: 0, right: 8}
    color: transparent
  }
  icon: {
    font: $fonts.icon
    padding: {left: 8, right: 6}
    color: transparent
  }
}

export const skenv = {
  theme: $theme.name
  defaults: $defaults
  spacer: {width: 8, color: "transparent"}
  widgets: {
    # NOTE: ===== left side items, ordered out to in =====
    apple: {
      enable: false
      name: apple
      color: $"($theme.colors.red)"
      side: left
    }
    aero_mode: {
      enable: true
      name: aero_mode
      # color: $"($theme.colors.orange)", 
      color: $"($theme.colors.red)"
      icon_font: $"($fonts.icon.family):($fonts.icon.style):($fonts.icon.size + 4)"
      update_freq: 5
      side: left
    }
    aerospace: {
      enable: true
      name: aerospace
      color_focused: $"($theme.colors.orange)"
      color_full: $"($theme.colors.magenta)"
      color_empty: $"($theme.colors.light_gray)"
      label_pad: 4
      outer_pad: 4
      update_freq: 5
      side: left
    }
    focused_app: {
      enable: true
      name: focused_app
      color: $"($theme.colors.green)"
      icon_font: $"($fonts.ske_app.family):($fonts.ske_app.style):($fonts.ske_app.size)"
      side: left
    }
    notifiers: {
      enable: true
      name: notifiers
      side: left
      # restart notifier
      restart_enable: true
      restart_color: $"($theme.colors.red)"
      restart_threshold: "7day"
      restart_update_freq: 3600
      # focus notifier
      focus_enable: true
      focus_update_freq: 30
      # update notifier
      updates_enable: true
      updates_color: $"($theme.colors.yellow)"
      updates_update_freq: 21600
    }
    # NOTE: ===== right side items, ordered out to in =====
    clock: {
      enable: true
      name: clock
      format: "%-m/%d %-l:%M" # reference with `format date -l`
      color: $"($theme.colors.yellow)"
      update_freq: 1
      side: right
    }
    volume: {
      enable: true
      name: volume
      color: $"($theme.colors.cyan)"
      icon_font: $"($fonts.icon.family):($fonts.icon.style):($fonts.icon.size + 4)"
      right_pad: $defaults.label.padding.right
      side: right
    }
    battery: {
      enable: true
      name: battery
      color: $"($theme.colors.orange)"
      side: right
      icon_font: $"($fonts.icon.family):($fonts.icon.style):($fonts.icon.size + 4)"
      update_freq: 5
    }
    mail: {
      enable: false
      name: mail
      color: $"($theme.colors.blue)"
      update_freq: 600
      side: right
    }
    dexcom: {
      enable: true
      name: dexcom
      color: $"($theme.colors.green)"
      icon_font: $"($fonts.ske_app.family):($fonts.ske_app.style):($fonts.ske_app.size)"
      update_freq: 300
      side: right
    }
    weather: {
      # TODO:
      enable: false
      name: weather
      color: $"($theme.colors.cyan)"
      location: Milwaukee
      temp_unit: F
      side: right
      stale_threshold: "30min"
    }
    caffeinate: {
      # TODO:
      enable: false
      name: caffeinate
      color: $"($theme.colors.green)"
      side: right
    }
    docker: {
      enable: true
      name: docker
      color: $"($theme.colors.blue)"
      icon_font: $"($fonts.icon.family):($fonts.icon.style):($fonts.icon.size + 4)"
      high_update_freq: 5
      low_update_freq: 60
      side: right
    }
  }
  animation: {type: exp, speed: 15}
  custom_events: [
    aerospace_workspace_change
    opencode-completion
  ]
}
