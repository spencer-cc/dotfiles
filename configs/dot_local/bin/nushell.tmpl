#!/bin/sh -l
export XDG_CONFIG_HOME="$HOME/.config"
{{ if eq .chezmoi.os "darwin" -}}
# darwin: nix-darwin embedded HM installs to /etc/profiles/per-user/$USER/bin
export PATH="/etc/profiles/per-user/$USER/bin:$HOME/.nix-profile/bin:/opt/homebrew/bin:$PATH"
{{- else -}}
# linux: standalone HM uses the home-manager profile
export PATH="$HOME/.local/state/nix/profiles/home-manager/home-path/bin:$HOME/.nix-profile/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
{{- end }}
exec nu --experimental-options='native-clip' "$@"
